-- Logs table
CREATE TABLE IF NOT EXISTS log_tbl (
    -- req Unique identifier of the log
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,

    -- Time is the timestamp (in seconds) of the log message
    time INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),

    -- Severity as an OpenTelemetry severity number (TRACE 1 … FATAL 21)
    level INTEGER NOT NULL,

    -- req Message is the log message or error associated with this log event
    message TEXT NOT NULL,

    -- StackTrace a stack trace associated with this log event
    stack TEXT,

    -- Structured attributes as JSON (OpenTelemetry-named keys). Stored beside
    -- the message rather than inside it so a reader can filter on values.
    meta TEXT,

    -- Which app launch produced this row; joins a crash report to its run.
    run_id TEXT
) STRICT;

-- Indexes
CREATE INDEX IF NOT EXISTS log_time_idx ON log_tbl (time);
CREATE INDEX IF NOT EXISTS log_level_idx ON log_tbl (level);

-- log_prefix_tbl (a hand-rolled prefix search index) was removed 2026-09-02: no code ever wrote
-- or read it. Existing installs drop it in the v2 migration rung (database.dart).
